{
  "name": "kosx-impact",
  "version": "0.1.0",
  "private": true,
  "description": "KOSX 万粉影响力计划：公开影响力数据平台",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:create": "wrangler d1 create kosx-impact",
    "db:migrate:local": "wrangler d1 migrations apply kosx-impact --local",
    "db:migrate:remote": "wrangler d1 migrations apply kosx-impact --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:members": "node scripts/validate-members.mjs",
    "build:og-fonts": "node scripts/build-og-fonts.mjs",
    "check": "npm run validate:members && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "hono": "^4.13.5",
    "motion": "^13.2.0",
    "radix-ui": "^1.6.7",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "subset-font": "^2.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
