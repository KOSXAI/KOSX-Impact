{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kosx-impact",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    // Vite 构建的静态资产（@cloudflare/vite-plugin 输出到 dist/client）
    "directory": "./dist/client",
    "binding": "ASSETS",
    // API / SVG 卡 / OG 图 / SEO 文件先经 Worker（Hono 分发）；
    // 页面路由（/ /members/:id /about）无静态资产，自然回退 Worker 做 SSR
    "run_worker_first": ["/api/*", "/card/*", "/og.svg", "/og/*", "/robots.txt", "/sitemap.xml"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kosx-impact",
      "database_id": "9ff1f928-b3dc-4033-b9fb-e82b6a62ed5b",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // 滚动采集：每小时整点跑一次，每次只采当前小时槽的成员分片（按 id 哈希分布）。
    // 成员被均匀分到 24 个槽，每人每天仍被采集一次，单次调用规模与总人数无关。
    // 错峰批量 cron（5-59/10，不与整点重叠）：只清自助更新队列——成员提交后
    // 数据最长 10 分钟内落地，不必等下一个整点。
    "crons": ["0 * * * *", "5-59/10 * * * *"]
  },
  "routes": [
    // 看板自定义域名（zone: kosx.ai）
    { "pattern": "impact.kosx.ai", "custom_domain": true }
  ]
}