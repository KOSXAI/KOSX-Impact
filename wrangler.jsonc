{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kosx-impact",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kosx-impact",
      "database_id": "9ff1f928-b3dc-4033-b9fb-e82b6a62ed5b",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // 滚动采集：每小时跑一次，每次只采当前小时槽的成员分片（按 id 哈希分布）。
    // 成员被均匀分到 24 个槽，每人每天仍被采集一次，单次调用规模与总人数无关。
    "crons": ["0 * * * *"]
  },
  "routes": [
    // 看板自定义域名（zone: kosx.ai）
    { "pattern": "10k.kosx.ai", "custom_domain": true }
  ]
}
