{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kosx-impact",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kosx-impact",
      "database_id": "13a56082-f3d4-4a23-a1de-0e29934ac99c",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // 每天 UTC 00:00（北京时间 08:00）采集一次数据
    "crons": ["0 0 * * *"]
  }
}
